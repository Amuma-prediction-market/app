# Every setting has a testnet default in src/config.ts; copy this file to .env.local to change one.
VITE_NETWORK=testnet
VITE_AIMM_CONTRACT=market.aimm-weather.testnet
# the token the demo's questions are paid in: the site lists only questions in it
VITE_COLLATERAL=tusd.aimm-weather.testnet
# the accounts trusted to resolve a question, comma-separated: both its resolver and its fallback must be one of them
VITE_RESOLVERS=aimm-weather-oracle.testnet
VITE_RPC_URL=https://rpc.testnet.fastnear.com
VITE_ARCHIVAL_RPC_URL=https://archival-rpc.testnet.fastnear.com
VITE_EXPLORER_URL=https://testnet.nearblocks.io
VITE_POLYMARKET_API=https://gamma-api.polymarket.com
# optional: a faucet that answers POST {"account": "name.testnet"} with a little testnet NEAR
VITE_GAS_FAUCET_URL=
VITE_POLYMARKET_CLOB=https://clob.polymarket.com
